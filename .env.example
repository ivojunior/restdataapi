DB_SERVER=localhost
DB_PORT=1433
DB_NAME=minha_base
DB_USER=sa
DB_PASSWORD=SenhaForte123!
DB_DRIVER=ODBC Driver 18 for SQL Server

API_KEY=troque-esta-chave-por-uma-secreta
API_KEY_NAME=X-API-Key
# Opcional: múltiplas chaves nomeadas, uma por cliente (permite revogar uma
# sem afetar as demais). Formato "cliente1:chave1,cliente2:chave2". Se
# definido, tem prioridade sobre API_KEY acima.
# API_KEYS=app-financeiro:chave-financeiro-secreta,app-estoque:chave-estoque-secreta

# Limite de requisições por IP aplicado a todas as rotas (formato slowapi).
RATE_LIMIT_DEFAULT=100/minute

# Em produção/exposição externa, defina como false para não publicar
# /docs, /redoc e /openapi.json sem autenticação.
DOCS_ENABLED=false

# Login via Google Workspace (SPA) — coexiste com a API Key acima, não a
# substitui. Client ID OAuth criado no Google Cloud Console (tipo "Web
# application").
GOOGLE_CLIENT_ID=
# Domínios do Google Workspace autorizados a logar, separados por vírgula.
# Vazio = nega todo login via Google (falha fechado).
ALLOWED_GOOGLE_DOMAINS=empresa.com.br
# Segredo para assinar o JWT de sessão da aplicação. Gerar com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=troque-este-segredo-tambem
SESSION_COOKIE_NAME=rda_session
SESSION_TTL_MINUTES=480
# Cookie Secure exige HTTPS; deixe true em produção. Só false em dev local
# servindo via http://localhost.
SESSION_COOKIE_SECURE=true
# Origem da SPA, se servida separadamente da API (CORS cross-site). Vazio
# quando a SPA é servida pelo próprio FastAPI (mesma origem — caso comum).
FRONTEND_ORIGIN=
