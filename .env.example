DB_SERVER=localhost
DB_PORT=1433
DB_NAME=minha_base
DB_USER=sa
DB_PASSWORD=SenhaForte123!
DB_DRIVER=ODBC Driver 18 for SQL Server

API_KEY=troque-esta-chave-por-uma-secreta
API_KEY_NAME=X-API-Key
# Opcional: múltiplas chaves nomeadas, uma por cliente (permite revogar uma
# sem afetar as demais). Formato "cliente1:chave1,cliente2:chave2". Se
# definido, tem prioridade sobre API_KEY acima.
# API_KEYS=app-financeiro:chave-financeiro-secreta,app-estoque:chave-estoque-secreta

# Limite de requisições por IP aplicado a todas as rotas (formato slowapi).
RATE_LIMIT_DEFAULT=100/minute

# Em produção/exposição externa, defina como false para não publicar
# /docs, /redoc e /openapi.json sem autenticação.
DOCS_ENABLED=false
